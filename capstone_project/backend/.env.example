# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=learnlink-dev-secret-change-in-production
JWT_SECRET_KEY=learnlink-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_HOURS=24
JWT_REFRESH_TOKEN_DAYS=30

# MySQL Database Settings
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=3306
DB_NAME=learnlink_db

# Frontend URL (for CORS)
CLIENT_ORIGIN=http://localhost:5173
