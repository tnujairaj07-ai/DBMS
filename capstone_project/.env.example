# ==============================================================================
# LearnLink - Environment Configuration Template
# Copy this file to backend/.env and update values for your environment
# ==============================================================================

# Flask Server Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=learnlink-dev-secret-change-in-production-2026
JWT_SECRET_KEY=learnlink-jwt-secure-secret-key-2026
JWT_ACCESS_TOKEN_HOURS=24
JWT_REFRESH_TOKEN_DAYS=30

# MySQL Database Settings (InnoDB 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD_HERE
DB_NAME=learnlink_db

# Frontend Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
