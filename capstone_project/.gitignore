__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.log
.cache

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Node & Frontend dependencies and builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# Environment variables & secrets (keep .env.example tracked)
.env
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# IDEs & System files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary and scratch files
scratch/
*.tmp
